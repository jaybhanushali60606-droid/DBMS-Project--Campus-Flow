# CampusFlow Backend Configuration

# Database Connection:
# For local SQLite development (default, zero configuration needed):
DATABASE_URL=sqlite:///./campusflow.db

# For PostgreSQL (production or local PostgreSQL server):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/campusflow

# JWT Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# University Attendance Policy
DEFAULT_ATTENDANCE_THRESHOLD=75.0
